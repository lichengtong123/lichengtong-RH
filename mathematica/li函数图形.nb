Notebook[{

Cell[CellGroupData[{
Cell["", "Title",
 CellChangeTimes->{
  3.995066129683298*^9},ExpressionUUID->"20ba779e-a798-434b-9bdb-\
616dc7e4fe92"],

Cell["", "Text",
 CellChangeTimes->{
  3.99506612224072*^9},ExpressionUUID->"ba2e7a40-f3eb-4191-a9e4-764cc0bcda70"],

Cell["\<\

(* |li(z)| modulus surface; li = LogIntegral; cut [1,+Infinity) *)
(* gold yellow matches zeta/Gamma modulus surfaces in the book *)

ClearAll[liAbs, plotLiModulus, plotLiContour, plotLiRealAxis, \
plotLiVsLiOffset, LiOffset];

liAbs[x_?NumericQ, y_?NumericQ] := Module[{z = x + I y}, \
Abs[LogIntegral[z]]];
LiOffset[x_?NumericQ] := LogIntegral[x] - LogIntegral[2];

(* Soldner constant: unique real zero of li on (1,+Infinity) *)
soldnerMu = 1.4513692348833811;

plotLiModulus[xMin_ : -2, xMax_ : 4, yMin_ : -3, yMax_ : 3, n_ : 80, zMax_ : \
8] :=
  Module[{surf, marks, mu = soldnerMu, r = 0.08},
   surf = Plot3D[liAbs[x, y], {x, xMin, xMax}, {y, yMin, yMax},
     PlotPoints -> n, MaxRecursion -> 3,
     PlotRange -> {{xMin, xMax}, {yMin, yMax}, {0, zMax}},
     Axes -> True, Boxed -> False, AxesOrigin -> {0, 0, 0},
     AxesStyle -> Directive[Black, AbsoluteThickness[0.05]],
     AxesLabel -> {\"Re z\", \"Im z\", \"|li(z)|\"},
     PlotLabel -> \"|LogIntegral[z]| = |li(z)|\",
     PlotStyle -> Directive[RGBColor[1.0, 0.84, 0.0], Opacity[0.80], \
Specularity[White, 30]],
     MeshFunctions -> {#1 &, #2 &, #3 &},
     Mesh -> {28, 28, 16},
     MeshStyle -> {
       Directive[GrayLevel[0.35], Opacity[0.90], AbsoluteThickness[0.6]],
       Directive[GrayLevel[0.35], Opacity[0.90], AbsoluteThickness[0.6]],
       Directive[GrayLevel[0.25], Opacity[0.95], AbsoluteThickness[0.7]]
     },
     Lighting -> \"Neutral\",
     Exclusions -> {y == 0 && x >= 1}, BoxRatios -> {1, 1, 0.55},
     ImageSize -> 1000];
   (* red marks: zero mu on floor; singularity z=1 with vertical dash *)
   marks = Graphics3D[{
     Red, Specularity[White, 20],
     (* zero: Soldner mu, |li|=0 *)
     Sphere[{mu, 0, 0}, 0.03],
     Text[Style[
       \"\:96f6\:70b9  \[Mu] = Soldner \:5e38\:6570 =\" <> \
ToString[NumberForm[mu, {7, 5}]] <> \"\\nli(\[Mu]) = 0\",
       11, Red, Bold], {mu, 0, 0.55 zMax}],
     (* singularity / branch point z=1 *)
     Sphere[{1, 0, 0}, 0.03],
     Directive[Red, Opacity[0.55], AbsoluteThickness[0.4]],
     Line[{{1, 0, 0}, {1, 0, zMax}}],
     Text[Style[
       \"\:5947\:70b9  z = 1\\n(\:5206\:652f\:70b9, |li|->Infinity)\",
       11, Red, Bold], {1, 0.35 (yMax - yMin), 0.72 zMax}]
     }];
   Show[surf, marks,
    PlotRange -> {{xMin, xMax}, {yMin, yMax}, {0, zMax}},
    Boxed -> False, Axes -> True, AxesOrigin -> {0, 0, 0},
    BoxRatios -> {1, 1, 0.55}, ImageSize -> 1000]
   ];

plotLiContour[xMin_ : -2, xMax_ : 4, yMin_ : -3, yMax_ : 3] :=
  Module[{mu = soldnerMu},
   ContourPlot[liAbs[x, y], {x, xMin, xMax}, {y, yMin, yMax},
     PlotPoints -> 100, Contours -> 20,
     ColorFunction -> (Blend[{RGBColor[1.0, 0.95, 0.55], RGBColor[1.0, 0.84, \
0.0], RGBColor[0.72, 0.40, 0.02]}, #] &),
     FrameLabel -> {\"Re z\", \"Im z\"},
     PlotLabel -> \"|li(z)| contours (red: zero & singularity)\",
     Epilog -> {
       Red, Thick, Line[{{1, 0}, {xMax, 0}}],
       PointSize[0.028],
       Point[{mu, 0}], Point[{1, 0}],
       Text[Style[
         \"zero \[Mu]=\" <> ToString[NumberForm[mu, {6, 4}]], 10, Red, Bold],
        {mu, 0.22 (yMax - yMin)}, {0, -1}],
       Text[Style[\"\:5947\:70b9. z=1\", 10, Red, Bold],
        {1, -0.22 (yMax - yMin)}, {0, 1}]
       }, ImageSize -> 480]
   ];

plotLiRealAxis[xMin_ : 1.05, xMax_ : 6] :=
  Plot[{LogIntegral[x], Abs[LogIntegral[x + 10.^-8 I]], Abs[LogIntegral[x - \
10.^-8 I]]},
    {x, xMin, xMax},
    PlotLegends -> {\"li(x)\", \"|li(x+i0)|\", \"|li(x-i0)|\"},
    AxesLabel -> {\"x\", None}, ImageSize -> 480];

plotLiVsLiOffset[xMin_ : 1.1, xMax_ : 20] :=
  Plot[{LogIntegral[x], LiOffset[x]}, {x, xMin, xMax},
    PlotLegends -> {\"li(x)\", \"Li(x)=li(x)-li(2)\"},
    AxesLabel -> {\"x\", None}, ImageSize -> 480];
plotLiModulus[]
plotLiContour[]\
\>", "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.99475381195117*^9, 3.994753824938233*^9}, {

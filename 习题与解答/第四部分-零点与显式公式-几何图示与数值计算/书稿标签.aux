\newlabel{sec:intro_zero_geometry}{{17.1}{197}{引言}{section.17.1}{}}
\newlabel{sec:zeta_real_surface}{{17.2}{197}{Riemann \texorpdfstring {$\zeta $}{Zeta} 函数的实部曲面}{section.17.2}{}}
\newlabel{fig:zeta_real_cont}{{17.1}{198}{解析延拓后的 $\zeta (s)$ 实部曲面。 曲面与参考面 $z=0$ 的交线即实部零迹线 $\operatorname {Re}(\zeta )=0$；临界线 $\operatorname {Re}(s)=\tfrac 12$ 是非平凡零点集的镜面对称轴（$s\mapsto 1-\bar s$，第\ref {subsec:fe-two-symmetries}节）。这一零点集的对称性不意味着 $\operatorname {Re}\zeta $ 曲面关于临界线镜面对称；$\operatorname {Re}\xi $ 则具有后一性质。}{figure.caption.185}{}}
\newlabel{sec:zeta_imag_surface}{{17.3}{198}{Riemann \texorpdfstring {$\zeta $}{Zeta} 函数的虚部曲面}{section.17.3}{}}
\newlabel{fig:zeta_imag_cont}{{17.2}{199}{解析延拓后的 $\zeta (s)$ 虚部曲面（共轭奇对称）。 曲面与参考面 $z=0$ 的交线即虚部零迹线 $\operatorname {Im}(\zeta )=0$。}{figure.caption.186}{}}
\newlabel{fig:zeta-real-imag-combined}{{17.3}{200}{$\zeta $ 实部与虚部曲面的半透明叠合图（对应图~\ref {fig:zeta_real_cont} 与图~\ref {fig:zeta_imag_cont}）。 两曲面共用底平面 $(\sigma ,t)$；竖直坐标 $z$ 在实部曲面上表示 $\operatorname {Re}\zeta (s)$，在虚部曲面上表示 $\operatorname {Im}\zeta (s)$，二者采用同一高度尺度。 位于参考面 $z=0$ 上的公共交点满足 $\operatorname {Re}(\zeta )=\operatorname {Im}(\zeta )=0$，即 $\zeta $ 的零点（临界带内为非平凡零点）。}{figure.caption.187}{}}
\newlabel{fig:zeta-zero-intersection}{{17.4}{200}{$\zeta $ 的零迹线 $\operatorname {Re}(\zeta )=0$ 与 $\operatorname {Im}(\zeta )=0$ 在 $z=0$ 上的投影。 纵轴 $\operatorname {Re}(s)$ 取负半轴朝上，与图~\ref {fig:zeta_real_cont}--\ref {fig:zeta-real-imag-combined} 的俯视投影一致（平凡零点在图上方）。 公共交点即 $\zeta $ 的零点（临界带内为非平凡零点）。}{figure.caption.188}{}}
\newlabel{sec:two-languages}{{17.5}{201}{\texorpdfstring {$\xi $}{xi} 的零迹线}{section.17.5}{}}
\newlabel{fig:xi-real-imag-combined}{{17.5}{202}{$\xi $ 实部与虚部曲面的半透明叠合图（对应图~\ref {fig:xi-real-imag} 与图~\ref {fig:xi-imag}；窗口见坐标轴，各曲线与标记见图下图例）。}{figure.caption.189}{}}
\newlabel{sec:xi-zero-topology}{{17.6}{202}{零迹线交点与黎曼猜想的几何表述}{section.17.6}{}}
\newlabel{fig:xi-real-imag-intersection}{{17.6}{203}{$\xi $ 的零迹线 $\operatorname {Re}(\xi )=0$ 与 $\operatorname {Im}(\xi )=0$ 在 $z=0$ 上的投影。 纵轴 $\operatorname {Re}(s)$ 取负半轴朝上，与图~\ref {fig:zeta_real_cont}--\ref {fig:zeta-zero-intersection} 一致。}{figure.caption.190}{}}
